{
	"$schema": "https://biomejs.dev/schemas/1.8.3/schema.json",
	
	"files": {
		"ignoreUnknown": false,
		"ignore": []
	},
	"formatter": {
		"indentStyle": "space"
	},
	"organizeImports": {
		"enabled": true
	  },
"linter": {
    "enabled": true,
    "rules": {
      "recommended": true
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double"
		}
	}
}
